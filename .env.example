# Copy to .env and adjust for your environment.
# Unraid example: http://192.168.1.130:8085

HTTP_PORT=8085

# --- PostgreSQL ---
POSTGRES_USER=receiptslegder
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=receiptslegder

# --- Website ---
DATABASE_URL=postgresql+psycopg://receiptslegder:change-me-to-a-strong-password@db:5432/receiptslegder
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password
TZ=Europe/Copenhagen
DOCUMENT_STORAGE_PATH=/app/data/documents
